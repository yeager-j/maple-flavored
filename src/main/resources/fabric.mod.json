{
	"schemaVersion": 1,
	"id": "maple_flavored",
	"version": "${version}",
	"name": "Maple Flavored",
	"description": "A slow-paced progression overhaul inspired by Matcha Flavoured and Raspberry Flavoured.",
	"authors": ["jackson"],
	"license": "CC-BY-NC-SA-4.0",
	"environment": "*",
	"entrypoints": {
		"main": ["mapleflavored.MapleFlavored"],
		"client": ["mapleflavored.client.MapleFlavoredClient"],
		"fabric-datagen": ["mapleflavored.client.datagen.MapleDataGenerator"]
	},
	"mixins": [
		"maple_flavored.mixins.json",
		"maple_flavored.access.mixins.json",
		{
			"config": "maple_flavored.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
